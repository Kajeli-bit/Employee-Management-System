# Copy to frontend/.env before running `npm run dev` or `npm run build`.

# Base URL of the API, no trailing slash. A build served over https upgrades an
# http:// value to https automatically, and an empty value means "same origin"
# (what the Vercel deployment uses, since it serves /api from its own domain).
VITE_API_URL=http://localhost:5000

# Clerk publishable key. The app fails fast without it, and a production build
# made without it tree-shakes the whole app away.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_c2luY2VyZS1wdWctMjk4NS5jbGVyay5hY2NvdW50cy5kZXYk

# Geoapify key for address search on the work location form (free at geoapify.com).
# Restrict it to your site domain in the Geoapify dashboard.
VITE_GEOAPIFY_API_KEY=01fb486949f746f79d6dafb62ba67bca
