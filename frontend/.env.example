# Copy to frontend/.env before running `npm run dev` or `npm run build`.

# Base URL of the API, no trailing slash.
VITE_API_URL=http://localhost:5000

# Clerk publishable key. The app fails fast without it, and a production build
# made without it tree-shakes the whole app away.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
