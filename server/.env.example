# Copy to server/.env and fill in real values. Never commit server/.env.
# The API refuses to start without a database URL.

# Shared MongoDB Atlas cluster URI only; database name is selected separately.
# Local backend processes always use the `test` database. Vercel always uses
# the `ems` database. The URI must not contain a different database path.
ATLASDB_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/

# Migration scripts are an explicit exception and require --apply.
# npm run migrate:test-to-ems -- --dry-run

# Signs the fallback JWT issued by /api/auth/login.
JWT_KEY=896c5d83f3a58542197b77aa1672181448b5e4f984834f27269f1265a9097d3db49cc9035b31373147c61983133538f6

# Clerk authentication. The publishable key is also needed by the frontend.
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_e1d3u7AnEHLha2IqTFXwOinNoi4YoCCosxRCnFZ6Zr

# Server-only bootstrap for a single company super-user. Generate a random
# 32+ character value, set this to the intended company's Mongo ObjectId, and
# never expose either value to the browser. Provision locally with:
# SUPER_USER_COMPANY_ID=<id> npm run provision:super-user -- <clerk-user-id> "reason"
SUPER_USER_BOOTSTRAP_KEY=
SUPER_USER_COMPANY_ID=

# Shared secret for the scheduled automatic clock-out check
# (GET /api/cron/attendance). Leave blank to disable that route: the check still
# runs from the employee app's location heartbeat.
CRON_SECRET=

# Browser origin(s) allowed to call the API, comma separated.
# Leave blank in local development to allow any origin.
CLIENT_URL=http://localhost:5173

# Optional: employee photo uploads. Photos are skipped when unset.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: bootstrap credentials used by `node userSeed.js`.
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@nilric.co.tz
ADMIN_PASSWORD=change-me

PORT=5000
