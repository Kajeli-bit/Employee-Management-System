# Copy to server/.env and fill in real values. Never commit server/.env.
# The API refuses to start without a database URL.

# MongoDB Atlas connection string (a replica set is required: company
# registration runs inside a transaction).
ATLASDB_URL=mongodb+srv://nilricdb:Kyon@255@nilric255.ebeseux.mongodb.net/

# Signs the fallback JWT issued by /api/auth/login.
JWT_KEY=896c5d83f3a58542197b77aa1672181448b5e4f984834f27269f1265a9097d3db49cc9035b31373147c61983133538f6

# Clerk authentication. The publishable key is also needed by the frontend.
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_e1d3u7AnEHLha2IqTFXwOinNoi4YoCCosxRCnFZ6Zr

# Browser origin(s) allowed to call the API, comma separated.
# Leave blank in local development to allow any origin.
CLIENT_URL=http://localhost:5173

# Optional: employee photo uploads. Photos are skipped when unset.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: bootstrap credentials used by `node userSeed.js`.
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@nilric.co.tz
ADMIN_PASSWORD=change-me

PORT=5000
